{
  "name": "unitel-credit-intelligence-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Credit Intelligence — Proxy Credit Rating, Limit & Approval POC for Unitel Angola",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npx tsx supabase/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
