# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Brevo API Configuration (HTTPS REST over Port 443 - Delivers to ANY Recipient Globally)
VITE_BREVO_API_KEY=xkeysib-your_brevo_api_key
VITE_BREVO_SENDER_EMAIL=your-verified-email@gmail.com

# Resend API Configuration (HTTPS REST over Port 443 - Direct Inbox Delivery)
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_EMAIL_FROM=Unitel Credit <onboarding@resend.dev>

# Email Notification Gateway (Gmail SMTP Backup)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password
