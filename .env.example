# Optional: configure Supabase to persist data to Postgres.
# When omitted, the portal automatically runs with the 300-customer local mock dataset.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: service role key for running `npm run seed`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email Dispatcher Configuration (Server-side / Edge Function)
# When EMAIL_API_KEY is omitted, the app runs in demo mode ("Not sent (demo mode)").
EMAIL_PROVIDER=resend # 'resend' | 'smtp' | 'demo'
EMAIL_API_KEY=
EMAIL_FROM="Unitel Credit Intelligence <credit@unitel.ao>"
APP_BASE_URL=http://localhost:5173

# Optional SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional client-side demo mode override ('true' forces demo mode banner and logging)
VITE_EMAIL_DEMO_MODE=true
VITE_APP_BASE_URL=http://localhost:5173
